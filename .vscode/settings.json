{
  // --- Python interpreter -------------------------------------------------
  // Points at the project virtual environment created per README.md.
  // On Windows change this to ".venv\\Scripts\\python.exe".
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,

  // Make `scripts/` importable so the QCar helpers resolve without installing
  // the project as a package.
  "python.analysis.extraPaths": ["${workspaceFolder}/scripts"],
  "python.analysis.typeCheckingMode": "basic",

  // The Quanser SDK (pal / qvl / quanser) is installed from the Quanser
  // distribution, not PyPI, so Pylance will not resolve it on a machine
  // without the QCar software. Downgrade that to a warning rather than an
  // error so the scripts stay readable off-vehicle.
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "warning",
    "reportMissingModuleSource": "warning"
  },

  // --- Formatting and linting ---------------------------------------------
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },

  // --- MATLAB --------------------------------------------------------------
  // Set matlab.installPath to your local MATLAB root to enable IntelliSense,
  // e.g. "C:\\Program Files\\MATLAB\\R2023b" or "/usr/local/MATLAB/R2023b".
  "matlab.indexWorkspace": true,

  // --- Files ---------------------------------------------------------------
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/slprj": true
  },

  // Treat MATLAB live scripts and Simulink models as binary so VS Code does
  // not try to diff them as text.
  "files.associations": {
    "*.mlx": "binary",
    "*.slx": "binary",
    "*.fis": "ini"
  },

  // --- Search ---------------------------------------------------------------
  "search.exclude": {
    "**/.venv": true,
    "**/data": true,
    "**/datasets": true,
    "**/models": true,
    "**/checkpoints": true
  },

  "cSpell.words": [
    "Quanser",
    "QUARC",
    "QLabs",
    "RealSense",
    "MINDSTORMS",
    "GoogleNet",
    "Simulink",
    "SOLIDWORKS",
    "Roboflow",
    "filterpy",
    "imutils",
    "sklearn",
    "Kalman"
  ]
}
